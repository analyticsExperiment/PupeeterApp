{
  "manifest_version": 3,
  "name": "Free Audit Recorder",
  "version": "0.5.0",
  "description": "Record journeys and run attached-tab audits in normal Chrome.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "webRequest", "cookies", "alarms"],
  "host_permissions": ["http://localhost:*/*", "http://127.0.0.1:*/*", "<all_urls>"],
  "action": {
    "default_title": "Free Audit Recorder",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selectorGenerator.js", "recorder.js", "contentScript.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
